{
  "schemaVersion": 1,
  "productName": "Haru",
  "repository": {
    "owner": "saketlunker",
    "name": "haru-releases",
    "apiBaseUrl": "https://api.github.com",
    "rawBaseUrlTemplate": "https://raw.githubusercontent.com/{owner}/{name}/{ref}/scripts/windows",
    "bootstrapRef": "main"
  },
  "install": {
    "rootDir": "%LOCALAPPDATA%\\Haru",
    "appDirName": "app",
    "binDirName": "bin",
    "stateDirName": "state",
    "logsDirName": "logs",
    "cacheDirName": "cache",
    "backupDirName": "app.previous",
    "executableName": "haru.exe",
    "startMenuFolder": "Haru",
    "shortcutName": "Haru.lnk",
    "updateShortcutName": "Update Haru.lnk"
  },
  "release": {
    "preferredExtension": ".zip",
    "artifactNameTemplate": "haru_{version}_{architecture}.zip",
    "workflowArtifactNameTemplate": "haru-windows-release-{architecture}",
    "outputDirectory": "dist\\release\\windows",
    "payloadDirectoryName": "haru",
    "assetSelectors": [
      {
        "architecture": "x64",
        "patterns": [
          "(?i)^haru_.*_x64.*\\.zip$",
          "(?i)^haru.*x64.*\\.zip$"
        ]
      },
      {
        "architecture": "arm64",
        "patterns": [
          "(?i)^haru_.*_arm64.*\\.zip$",
          "(?i)^haru.*arm64.*\\.zip$"
        ]
      },
      {
        "architecture": "neutral",
        "patterns": [
          "(?i)^haru(?!.*(?:x64|arm64)).*\\.zip$"
        ]
      }
    ]
  },
  "supportFiles": [
    "Haru.ps1",
    "Install-Haru.ps1",
    "Update-Haru.ps1",
    "Haru.Common.psm1",
    "Haru.Release.json"
  ]
}
